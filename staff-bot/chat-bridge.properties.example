# Copy to a PRIVATE file on the StaffBot container; do not commit the filled-in copy.
# Use chmod 600 (owner read/write only) when supported.
# This example contains no real credentials. Values are loaded ONLY when the
# approved --chat-bridge-config-file=<path> startup option is supplied.
# Keep existing --environment=production, --token-file=tp, and --moderation-config-file=m
# unchanged in Bloom. Do not insert tokens into Bloom APP FLAGS.
# The current CI artifact on Bloom does NOT support this option yet.
ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_MODE=SHADOW
ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_MIGRATION_ACK=I_ACKNOWLEDGE_PRODUCTION_SHADOW_MIGRATION
ENTHUSIA_STAFF_BOT_PUBLIC_CHAT_TOKEN=REPLACE_WITH_SEPARATE_PUBLIC_CHAT_BOT_TOKEN
ENTHUSIA_STAFF_BOT_PUBLIC_CHAT_APPLICATION_ID=1405605074331373718
ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_HOST=REPLACE_WITH_REACHABLE_VELOCITY_TLS_HOST
ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_PORT=28765
ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_CLIENT_SECRET=REPLACE_WITH_BASE64_STAFFBOT_PEER_HMAC
ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_PROXY_SECRET=REPLACE_WITH_EXISTING_BASE64_VELOCITY_PROXY_HMAC
ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_TRUST_STORE=REPLACE_WITH_PATH_TO_TRUSTED_PUBLIC_TLS_CERTIFICATE_STORE
ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_TRUST_STORE_PASSWORD=REPLACE_WITH_PRIVATE_TRUSTSTORE_PASSWORD
ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_ROUTES=SMP/global=1541286004298752091
# Intentionally leave ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_INGRESS_ROUTES absent
# for first outbound-only private SHADOW tests. Never enable AUTHORITATIVE yet.

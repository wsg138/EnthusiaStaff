{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "enthusia-staff-moderation-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-08-30",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "staff-staging.enthusia.info",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSION_STORE",
        "class_name": "ModerationSessionStore"
      }
    ]
  },
  "exports": {
    "ModerationSessionStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "EXPECTED_GUILD_ID": "1410303324745371709",
    "STAGING_LABEL": "staging"
  },
  "secrets": {
    "required": [
      "LAUNCH_SIGNING_KEY_HEX",
      "READ_API_SIGNING_KEY_HEX"
    ]
  }
}

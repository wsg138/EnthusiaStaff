# Read-only TCP/TLS probe only. Never give the probe the Discord bot token.
# Copy into a PRIVATE untracked file inside the authorized StaffBot container.
# Read-only helper accepts only this fixed host and port.
ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_HOST=25319956-7c92-49d1-9afe-ea6e18758016
ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_PORT=28765
ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_TRUST_STORE=REPLACE_WITH_STAFFBOT_LOCAL_PUBLIC_TRUSTSTORE_PATH
ENTHUSIA_STAFF_BOT_CHAT_BRIDGE_TRUST_STORE_PASSWORD=REPLACE_WITH_PRIVATE_TRUSTSTORE_PASSWORD

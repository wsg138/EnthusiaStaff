# Placeholder-only Staff Bot staging runtime inventory.
# Store real values only in Bloom/Pterodactyl secret/environment fields.

ENTHUSIA_STAFF_BOT_ENVIRONMENT=staging
ENTHUSIA_STAFF_BOT_TOKEN=<discord-bot-token>

ENTHUSIA_STAFF_BOT_DB_JDBC_URL=jdbc:mariadb://<private-db-host>:3306/<staff-database>
ENTHUSIA_STAFF_BOT_DB_USERNAME=<staff-db-user>
ENTHUSIA_STAFF_BOT_DB_PASSWORD=<staff-db-password>

ENTHUSIA_STAFF_BOT_AUTHORITY_URL=http://<private-paper-host>:8771/v1/staff-rank
ENTHUSIA_STAFF_BOT_AUTHORITY_TRANSPORT=bloom-private-split
ENTHUSIA_STAFF_DISCORD_AUTHORITY_SECRET=<shared-random-secret-at-least-32-characters>
ENTHUSIA_STAFF_BOT_COMPONENT_SECRET=<different-random-secret-at-least-32-characters>

ENTHUSIA_STAFF_BOT_HEALTH_HOST=127.0.0.1
ENTHUSIA_STAFF_BOT_HEALTH_PORT=8765
ENTHUSIA_STAFF_BOT_WORKER_THREADS=4
ENTHUSIA_STAFF_BOT_WORKER_QUEUE_CAPACITY=256
ENTHUSIA_STAFF_BOT_INTERACTION_CAPACITY=4096
ENTHUSIA_STAFF_BOT_INTERACTION_TTL_SECONDS=900
ENTHUSIA_STAFF_BOT_DB_POOL_SIZE=4
ENTHUSIA_STAFF_BOT_DB_TIMEOUT_MILLIS=3000

# Initial staging launch must remain non-destructive.
ENTHUSIA_STAFF_BOT_DISCORD_ENFORCEMENT_ENABLED=false
